# ─────────────────────────────────────────────────────────────────────────────
# pneuma-knowledge-compiler 配置模板。
# 无密钥体验请直接运行 `uv run python examples/seed_demo.py` 并导入内置 preset；
# 需要真实编译/召回时再复制为 .env，并配置一个 OpenRouter key。
# LLM 与 embedding 全部复用 OpenRouter，无需其他供应商的 key。
# 中间件地址（Postgres/Qdrant/Meilisearch）的默认值已对齐 infra/docker-compose.yml，
# 本地跑 demo 无需在这里配置。
# ─────────────────────────────────────────────────────────────────────────────

# 【真实模型可选】OpenRouter API key（https://openrouter.ai/keys）。
OPENROUTER_API_KEY=sk-or-替换成你的key

# LLM 按操作路由（都走 OpenRouter）。这里使用公开的通用示例；可替换为任意
# 支持 tool calling / structured output 的 openrouter:<model>。
PNEUMA_KNOWLEDGE_LLM_MODEL_COMPILE=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_RECALL=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_DEEP=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_SKILL=openrouter:openai/gpt-4o-mini

# 【可选】所有角色共用的供应商调用护栏（默认值已够用，通常不需要改）：
#   LLM_TIMEOUT     = 单次请求超时（秒）。故意设得很大：目的是防「挂死」而不是防「慢」，
#                     调小会误杀慢而仍活着的请求。
#   LLM_MAX_RETRIES = langchain 自带的瞬时错误（429/5xx/连接重置）重试次数。
# PNEUMA_KNOWLEDGE_LLM_TIMEOUT=600
# PNEUMA_KNOWLEDGE_LLM_MAX_RETRIES=3

# L2 语义向量的 embedding（走 OpenRouter，1536 维，复用上面的 key）。
PNEUMA_KNOWLEDGE_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small

# L2 分块策略：
#   semantic = 用 LLM 判「一人一段 / 一主题一段」的边界（推荐，效果最好；入库时多一次 LLM 调用）。
#   sentence = 纯机械的句子切分（无需 LLM，最省，作为回退）。
PNEUMA_KNOWLEDGE_CHUNK_STRATEGY=semantic

# 【可选】Langfuse 可观测性：三项都填才开启追踪；任一为空则自动降级为 no-op（零影响）。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
