.DS_Store
# Root canonical git repos (per-user, large and rebuildable).
/data/

# Seed-bench raw run outputs — kept locally, not shipped (only the curated
# examples/seed-bench/README.md is tracked). Other experiment data stays local too.
examples/seed-bench/runs/
examples/opc/.env
examples/opc/var/

# Pneuma workspace (project config + session state) — local, not part of the codebase.
.pneuma/

# Local-only private datasets: real personal/corporate material used for local
# experiments (raw captures, prepared payloads, prep scripts, derived memory).
# NEVER shipped — the open repository carries only synthetic fixtures.
/local/
