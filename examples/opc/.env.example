# Environment for the OPC example — this machine's infrastructure, and the key.
# Copy to .env before use. The API key lives in that file only (gitignored), never committed.
#
# Strategy is NOT here: model roles, prices, components, chunking, answer style, the compile
# contract and the owner profile all live in engine/ — this project's own versioned unit
# (see engine/README.md). app.py loads this file into the process environment, so a
# PNEUMA_KNOWLEDGE_* strategy key placed here would outrank the engine file — reserve that
# for temporary operations.

# OpenRouter API key (https://openrouter.ai/keys). Empty is a supported state: the shipped
# library browses, its citations resolve, and only the lanes that call a model need this.
OPENROUTER_API_KEY=

# Provider routing for every `openrouter:<model>` role above. NOT an engine key — it is this
# machine's route to a vendor, not this project's strategy. Without it OpenRouter may serve a
# GPT-series request from a third-party reseller of the same model: different quantization,
# different behavior, silently, and no prompt cache across a compile's tool loop. Pinned, with
# fallbacks off, the request fails loudly instead.
PNEUMA_KNOWLEDGE_OPENROUTER_PROVIDER_ORDER=openai
PNEUMA_KNOWLEDGE_OPENROUTER_ALLOW_FALLBACKS=false

# This project's engine directory, so the framework API (and its Engine Console) serves this
# engine when started from the project root.
PNEUMA_KNOWLEDGE_ENGINE_DIR=./engine

# Framework repository (app.py runs via its uv environment). Auto-probed upward while this
# project lives inside the repository; set it once it is copied out.
# PNEUMA_APP_FRAMEWORK_REPO=

# Compose project name and ports — fixed for this example (a generated project probes free
# ones), disjoint from the framework dev stack and from the generated-project defaults. The
# project name owns the docker volumes; renaming orphans them.
PNEUMA_APP_COMPOSE_PROJECT=pneuma-opc-example
PNEUMA_APP_PG_PORT=25432
PNEUMA_APP_QDRANT_PORT=26333
PNEUMA_APP_QDRANT_GRPC_PORT=26334
PNEUMA_APP_MEILI_PORT=27700
PNEUMA_APP_RUSTFS_PORT=29000
PNEUMA_APP_RUSTFS_CONSOLE_PORT=29001
PNEUMA_APP_RUSTFS_ACCESS_KEY=
PNEUMA_APP_RUSTFS_SECRET_KEY=
# The browsing layer (framework API + web UI), started only by the optional
# `console` compose profile:  docker compose --profile console up -d --wait
PNEUMA_APP_API_PORT=28000
PNEUMA_APP_WEB_PORT=24173
# Optional container-side override for a Langfuse server on this host.
PNEUMA_APP_LANGFUSE_BASE_URL_CONTAINER=
PNEUMA_APP_LANGFUSE_LOCALHOST_GATEWAY=
# Without a key, every process runs model-free and embeds with a deterministic vector. Its
# dimension must match the collection this engine's embedding model created.
# PNEUMA_APP_KEYLESS_EMBEDDING=fake:1536
# Project-private Docker subnet (avoids default address-pool exhaustion).
PNEUMA_APP_SUBNET=10.222.223.0/24

# Tenant id: a different id is a different, empty library. The shipped library is u-opc-lin's.
PNEUMA_APP_USER_ID=u-opc-lin
