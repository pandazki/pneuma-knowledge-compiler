# Local runtime artifacts and secrets — never committed.
.env
data/
__pycache__/
# Where an evaluation run writes: its scorecards, and the L0 dumps it harvests to compute
# the metrics a canonical repository alone cannot. Derived, and re-derivable by re-running.
var/
# The engine directory is versioned twice over: its files live in this repository, and the
# engine console commits its own history inside it. That history is local to a checkout.
engine/.git/
