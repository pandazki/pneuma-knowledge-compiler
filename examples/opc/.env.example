# Isolated host-side endpoints for examples/opc/compose.yaml.
PNEUMA_KNOWLEDGE_PG_DSN=postgresql://opc_example:opc_example@127.0.0.1:25432/opc_example
PNEUMA_KNOWLEDGE_QDRANT_URL=http://127.0.0.1:26333
PNEUMA_KNOWLEDGE_QDRANT_COLLECTION=opc_example_chunks
PNEUMA_KNOWLEDGE_MEILI_URL=http://127.0.0.1:27700
PNEUMA_KNOWLEDGE_MEILI_KEY=opc_example_local_key
PNEUMA_KNOWLEDGE_CANONICAL_ROOT=./var/opc-example/canonical

PNEUMA_KNOWLEDGE_DEFAULT_TIMEZONE=Asia/Shanghai
PNEUMA_KNOWLEDGE_USER_SCHEMA_PACKS=true
PNEUMA_KNOWLEDGE_USER_SCHEMA_BASE_VERSION=opc-example-v1
PNEUMA_KNOWLEDGE_USER_SCHEMA_MATRIX_PATH=examples/opc/assets/schema-matrix.json
PNEUMA_KNOWLEDGE_CHUNK_STRATEGY=sentence
PNEUMA_KNOWLEDGE_EVOLVE_AUTO_TRIGGER=false

# Keyless default. `example_settings("keyless")` also enforces these values.
PNEUMA_KNOWLEDGE_LLM_MODEL=scripted:examples/opc/data/demo/replay/recall.json
PNEUMA_KNOWLEDGE_EMBEDDING_MODEL=fake:64

# For real mode, copy this file to `.env`, set every operation route explicitly,
# choose a real embedding model and provide OPENROUTER_API_KEY in your shell.
# PNEUMA_KNOWLEDGE_LLM_MODEL_COMPILE=openrouter:<strong-write-model>
# PNEUMA_KNOWLEDGE_LLM_MODEL_RECALL=openrouter:<fast-answer-model>
# PNEUMA_KNOWLEDGE_LLM_MODEL_DEEP=openrouter:<strong-reasoning-model>
# PNEUMA_KNOWLEDGE_LLM_MODEL_LIVE_CONTEXT=openrouter:<low-latency-model>
# PNEUMA_KNOWLEDGE_LLM_MODEL_EVOLVE=openrouter:<strong-write-model>
# PNEUMA_KNOWLEDGE_LLM_MODEL_SKILL=openrouter:<strong-write-model>
# PNEUMA_KNOWLEDGE_EMBEDDING_MODEL=openrouter:<embedding-model>
# OPENROUTER_API_KEY=<provider-key>
