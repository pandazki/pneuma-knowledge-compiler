                  {"header_id": "g25e-jump-reply-h03", "name": "To", "value": "林舟 <lin.zhou@seamlog.test>", "authorship": {"authored_id": "g25e-jump-reply-h03-auth", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}},
                  {"header_id": "g25e-jump-reply-h04", "name": "Subject", "value": "Re: 来源跳转修正：保留原位置的处理方式", "authorship": {"authored_id": "g25e-jump-reply-h04-auth", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}},
                  {"header_id": "g25e-jump-reply-h05", "name": "Message-ID", "value": "<g25e-jump-reply@review.test>", "authorship": {"authored_id": "g25e-jump-reply-h05-auth", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}},
                  {"header_id": "g25e-jump-reply-h06", "name": "In-Reply-To", "value": "<g25e-jump-root@seamlog.test>", "authorship": {"authored_id": "g25e-jump-reply-h06-auth", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}},
                  {"header_id": "g25e-jump-reply-h07", "name": "References", "value": "<g25e-jump-root@seamlog.test>", "authorship": {"authored_id": "g25e-jump-reply-h07", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}}
                ],
                "full_text": "林舟：\n\n分开。状态是人对材料当前处境的判断；跳转修正是读者能否抵达同一来源位置的技术观察。两者共用一行只会让人以为链接修好就等于状态被确认。原位置、出现的旧说明页、检查时间和后来能抵达的目标都应保留在修正记录里。\n\n修好后也别删那段观察。显示层可以默认带人去实际位置，但旁边要能回看为什么曾经跳偏、由谁在何时复核过。若目标后来再次移动，应新增一条观察而非改写第一次的中间页；这样读者能辨认修的是跳转关系，不是重写来源。等你有新的观察再更新进度；现在不要把“修正中”写成已完成，更不要由此推任何验收结论。下次检查若仍经过旧说明页，就追加一次带时间的观察；若已抵达新目标，也只记录这个变化，不删除以前的观察。\n\n贾宁",
                "in_reply_to": "g25e-jump-root", "references": ["g25e-jump-root"], "attachments": [],
                "authorship": {"authored_id": "g25e-jump-reply-auth", "occurred_at": "2026-05-15T15:32:00+08:00", "author_role": "engineering", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C05", "C02", "C06"]}}
