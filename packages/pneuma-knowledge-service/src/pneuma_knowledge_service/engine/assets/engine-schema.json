{
  "schema_version": 1,
  "stages": [
    {
      "id": "intake",
      "title": {
        "en": "Intake",
        "zh": "接收"
      },
      "summary": {
        "en": "Material arrives verbatim (L0) and is cut into semantic units for the vector index (L2). Only the cutting is a choice — the text stays a verbatim slice.",
        "zh": "材料逐字入库（L0），并被切成语义单元供向量索引（L2）使用。可选的只有怎么切——切出来的文本始终是原文的逐字片段。"
      },
      "doc": "docs/reference/configuration.md#l2-chunking",
      "file": "intake/intake.yaml",
      "knobs": [
        {
          "key": "chunk_strategy",
          "env": "PNEUMA_KNOWLEDGE_CHUNK_STRATEGY",
          "type": "enum",
          "enum": [
            "semantic",
            "sentence",
            "recursive"
          ],
          "default": "semantic",
          "apply": "derived_rebuild",
          "label": {
            "en": "Chunk strategy",
            "zh": "切块策略"
          },
          "description": {
            "en": "semantic = the compile-role model detects topic/episode boundaries and returns each segment with a derived episode title/description for embedding; sentence / recursive = mechanical chonkie chunkers with no model cost. Citable chunk text always stays verbatim.",
            "zh": "semantic = 由编译角色模型判断话题/情节边界，并为每个段返回用于 embedding 的派生 episode 标题/描述；sentence / recursive = 机械切分，不花模型钱。可引用 chunk 文本始终保持逐字原文。"
          }
        },
        {
          "key": "semantic_overlap",
          "env": "PNEUMA_KNOWLEDGE_SEMANTIC_OVERLAP",
          "type": "enum",
          "enum": [
            "off",
            "smart"
          ],
          "default": "smart",
          "apply": "derived_rebuild",
          "label": {
            "en": "Segment overlap",
            "zh": "段落重叠"
          },
          "description": {
            "en": "Only for the semantic strategy. smart = each returned episode object ends with closed-interval start/end coordinates, so a hinge — the sentence that closes one topic while opening the next — is indexed as part of both segments; how much to share is decided per boundary, and at most three blocks ever, which is what stops the model from making every segment the whole document. off = the original zero-overlap geometry. Episode descriptions created a new prompt baseline, so older boundary-only measurements are not same-harness comparisons. Existing content keeps its recorded boundaries until rebuild_derived runs.",
            "zh": "只对 semantic 策略有意义。smart = 每个 episode 对象末尾返回 start/end 前闭后闭坐标，转折句——那句既收束上一话题、又开启下一话题的话——同时被索引进前后两段；共享多少由模型逐个边界判断，且最多三块，正是这个上限让模型无法把每一段都写成全文。off = 原来的零重叠几何形状。episode 描述产生了新提示词基线，旧的 boundary-only 测量不属于同一 harness。已有内容会保留既有边界，直到跑 rebuild_derived 才真正改变。"
          }
        }
      ]
    },
    {
      "id": "compile",
      "title": {
        "en": "Compile",
        "zh": "编译"
      },
      "summary": {
        "en": "The model reads the material and writes canonical documents under this engine's contract. Every write passes the citation gate.",
        "zh": "模型在本引擎的契约之下阅读材料、写出正本文档。每一次写入都要过引用闸门。"
      },
      "doc": "docs/guides/compile-contract.md",
      "file": "compile/contract.md",
      "knobs": [
        {
          "key": "contract",
          "env": "",
          "type": "document",
          "default": "",
          "apply": "future_compiles",
          "label": {
            "en": "Compile contract",
            "zh": "编译契约"
          },
          "description": {
            "en": "The constitution: what deserves long-term memory in this domain, and on which page. A judgement document — never decomposed into toggles. Rewriting it governs future compiles only; canonical is never rewritten.",
            "zh": "宪法：在这个领域里什么值得被长期记住、该记在哪一页。它是判断力文档——永远不会被拆成开关。改写它只管未来的编译；正本永不被回溯重写。"
          }
        }
      ]
    },
    {
      "id": "challenge",
      "title": {
        "en": "Coverage challenge",
        "zh": "覆盖质询"
      },
      "summary": {
        "en": "After a committed compile, blind questions are generated over the same material and the canon is probed for gaps; confirmed gaps can trigger one compensation compile.",
        "zh": "编译提交后，对同一份材料盲出问题、拿着问题查正本的缺口；确认的缺口可以触发一次补偿编译。"
      },
      "doc": "docs/reference/configuration.md#post-compile-coverage-challenge",
      "file": "compile/challenge.yaml",
      "knobs": [
        {
          "key": "enabled",
          "env": "PNEUMA_KNOWLEDGE_CHALLENGE_ENABLED",
          "type": "bool",
          "default": false,
          "apply": "future_compiles",
          "label": {
            "en": "Audit after every compile",
            "zh": "每次编译后审计"
          },
          "description": {
            "en": "Off by default: the audit spends extra model calls per compile job. On, it mechanizes the contract guide's \"ask real questions\" acceptance step.",
            "zh": "默认关：审计会为每个编译作业额外花模型调用。开启后，它把契约指南里「拿真问题去问」这一步验收机械化。"
          }
        },
        {
          "key": "max_rounds",
          "env": "PNEUMA_KNOWLEDGE_CHALLENGE_MAX_ROUNDS",
          "type": "int",
          "default": 2,
          "apply": "future_compiles",
          "label": {
            "en": "Max rounds",
            "zh": "最多轮数"
          },
          "description": {
            "en": "Question/reflection rounds per audit. Either stage may end early by declaring itself exhausted.",
            "zh": "每次审计的出题/反思轮数。任一阶段都可以自称穷尽而提前结束。"
          }
        },
        {
          "key": "max_questions",
          "env": "PNEUMA_KNOWLEDGE_CHALLENGE_MAX_QUESTIONS",
          "type": "int",
          "default": 6,
          "apply": "future_compiles",
          "label": {
            "en": "Questions per round",
            "zh": "每轮问题数"
          },
          "description": {
            "en": "How many blind questions one round generates.",
            "zh": "一轮盲出多少个问题。"
          }
        },
        {
          "key": "max_output_tokens",
          "env": "PNEUMA_KNOWLEDGE_CHALLENGE_MAX_OUTPUT_TOKENS",
          "type": "int",
          "default": 32768,
          "apply": "future_compiles",
          "label": {
            "en": "Output budget (tokens)",
            "zh": "输出预算（token）"
          },
          "description": {
            "en": "Completion cap for the audit's structured passes. A healthy reply is small; without a cap a runaway generation runs to the provider ceiling before failing to parse. 0 = provider default.",
            "zh": "审计结构化调用的完成上限。健康回复很小；不设上限时一次失控生成会跑满供应商上限才解析失败。0 = 供应商默认。"
          }
        },
        {
          "key": "compensate",
          "env": "PNEUMA_KNOWLEDGE_CHALLENGE_COMPENSATE",
          "type": "bool",
          "default": true,
          "apply": "future_compiles",
          "label": {
            "en": "Compensation compile",
            "zh": "补偿编译"
          },
          "description": {
            "en": "Confirmed gaps enqueue one extra compile over the same material; its writes pass the ordinary citation gate like any other.",
            "zh": "确认的缺口会为同一份材料再排一次编译；它的写入和其他写入一样要过普通的引用闸门。"
          }
        }
      ]
    },
    {
      "id": "evolve",
      "title": {
        "en": "Schema evolve",
        "zh": "模式演进"
      },
      "summary": {
        "en": "Once enough new material has accrued, a strong model proposes reorganizing the library's structure on a branch and waits for a human to adopt or drop it.",
        "zh": "积累够多新材料后，强模型会在分支上提出重组知识库结构的方案，等人来采纳或丢弃。"
      },
      "doc": "docs/guides/evolution.md",
      "file": "evolve/evolve.yaml",
      "knobs": [
        {
          "key": "auto_trigger",
          "env": "PNEUMA_KNOWLEDGE_EVOLVE_AUTO_TRIGGER",
          "type": "bool",
          "default": true,
          "apply": "future_compiles",
          "label": {
            "en": "Passive trigger",
            "zh": "被动触发"
          },
          "description": {
            "en": "Whether compiles may fire an evolve round. Off leaves evolution entirely manual; nothing is ever reorganized without a review either way.",
            "zh": "编译是否可以触发演进。关掉后演进全靠手动；无论开关如何，没有评审就不会有任何重组落地。"
          }
        },
        {
          "key": "trigger_topic_docs",
          "env": "PNEUMA_KNOWLEDGE_EVOLVE_TRIGGER_TOPIC_DOCS",
          "type": "int",
          "default": 5,
          "apply": "future_compiles",
          "label": {
            "en": "New documents threshold",
            "zh": "新文档阈值"
          },
          "description": {
            "en": "New canonical documents since the last evolve needed to fire (AND-ed with the claim threshold). Lower it for a slow-trickle library.",
            "zh": "距上次演进新增多少正本文档才触发（与断言阈值取与）。材料细水长流的库可以调低。"
          }
        },
        {
          "key": "trigger_new_claims",
          "env": "PNEUMA_KNOWLEDGE_EVOLVE_TRIGGER_NEW_CLAIMS",
          "type": "int",
          "default": 30,
          "apply": "future_compiles",
          "label": {
            "en": "New claims threshold",
            "zh": "新断言阈值"
          },
          "description": {
            "en": "New anchors since the last evolve needed to fire.",
            "zh": "距上次演进新增多少锚点才触发。"
          }
        },
        {
          "key": "draft_ttl_hours",
          "env": "PNEUMA_KNOWLEDGE_EVOLVE_DRAFT_TTL_HOURS",
          "type": "int",
          "default": 24,
          "apply": "future_compiles",
          "label": {
            "en": "Draft lifetime (hours)",
            "zh": "草案存活时长（小时）"
          },
          "description": {
            "en": "A draft older than this is lazily expired the next time the list is read. The setting accepts fractions; the console steps in whole hours.",
            "zh": "超过这个时长的草案会在下次读列表时被惰性过期。设置本身接受小数，控制台按整小时步进。"
          }
        }
      ]
    },
    {
      "id": "recall",
      "title": {
        "en": "Recall",
        "zh": "召回"
      },
      "summary": {
        "en": "The answering lanes: retrieval over claims and source windows, then an answer whose every conclusion carries a citation.",
        "zh": "回答车道：在断言与源窗口上检索，然后给出每条结论都带引用的回答。"
      },
      "doc": "docs/architecture.md#7-retrieval",
      "file": "recall/recall.yaml",
      "knobs": [
        {
          "key": "answer_style",
          "env": "PNEUMA_KNOWLEDGE_RECALL_ANSWER_STYLE",
          "type": "enum",
          "enum": [
            "concise",
            "conversational",
            "detailed"
          ],
          "default": "conversational",
          "apply": "hot",
          "label": {
            "en": "Answer style",
            "zh": "回答风格"
          },
          "description": {
            "en": "Shape only: concise = the bare exact value a grader or script expects; conversational = a natural chat reply; detailed = a self-contained note. Truth discipline is style-independent.",
            "zh": "只影响形状：concise = 评分器或脚本要的那个确切值；conversational = 自然的对话回复；detailed = 自成一体的书面笔记。真话纪律与风格无关。"
          }
        },
        {
          "key": "claim_candidate_cap",
          "env": "PNEUMA_KNOWLEDGE_RECALL_CLAIM_CANDIDATE_CAP",
          "type": "int",
          "default": 80,
          "apply": "hot",
          "label": {
            "en": "Claim candidate depth",
            "zh": "断言候选深度"
          },
          "description": {
            "en": "How many claims each retrieval face may consider before dedup, optional reranking, and the final answer cap. Index breadth is cheaper than model context.",
            "zh": "每条检索路径在去重、可选重排与最终回答上限之前可考虑多少断言。索引广度比模型上下文便宜。"
          }
        },
        {
          "key": "claim_cap",
          "env": "PNEUMA_KNOWLEDGE_RECALL_CLAIM_CAP",
          "type": "int",
          "default": 40,
          "apply": "hot",
          "label": {
            "en": "Claim budget",
            "zh": "断言预算"
          },
          "description": {
            "en": "How many compiled claims may enter the final answer context after broad candidate retrieval.",
            "zh": "宽候选召回之后，最多有多少条已编译断言可进入最终回答上下文。"
          }
        },
        {
          "key": "window_candidate_cap",
          "env": "PNEUMA_KNOWLEDGE_RECALL_WINDOW_CANDIDATE_CAP",
          "type": "int",
          "default": 60,
          "apply": "hot",
          "label": {
            "en": "Source-window candidate depth",
            "zh": "源窗口候选深度"
          },
          "description": {
            "en": "How many fused lexical/raw/episode source spans survive retrieval for the episode-summary and verbatim context faces.",
            "zh": "有多少条词法／raw／episode 融合源区间可从检索进入 episode 摘要与逐字上下文两面。"
          }
        },
        {
          "key": "episode_summary_cap",
          "env": "PNEUMA_KNOWLEDGE_RECALL_EPISODE_SUMMARY_CAP",
          "type": "int",
          "default": 24,
          "apply": "hot",
          "label": {
            "en": "Episode summary budget",
            "zh": "Episode 摘要预算"
          },
          "description": {
            "en": "How many dense, explicitly derived episode summaries may enter the final answer context alongside exact source metadata.",
            "zh": "最多有多少条高密度、明确标为派生内容的 episode 摘要可连同精确来源元数据进入最终回答上下文。"
          }
        },
        {
          "key": "window_cap",
          "env": "PNEUMA_KNOWLEDGE_RECALL_WINDOW_CAP",
          "type": "int",
          "default": 6,
          "apply": "hot",
          "label": {
            "en": "Source window budget",
            "zh": "源窗口预算"
          },
          "description": {
            "en": "How many exact verbatim source windows may enter the final answer context.",
            "zh": "最多有多少个精确逐字源窗口可进入最终回答上下文。"
          }
        },
        {
          "key": "plan_queries",
          "env": "PNEUMA_KNOWLEDGE_RECALL_PLAN_QUERIES",
          "type": "int",
          "default": 0,
          "apply": "hot",
          "label": {
            "en": "Planned extra queries",
            "zh": "规划的额外查询数"
          },
          "description": {
            "en": "0 = the single-query lane, byte-for-byte. N > 0: one small call derives up to N extra retrieval queries, all pooled through one RRF fusion.",
            "zh": "0 = 单查询车道，逐字节不变。N > 0：一次小调用推导出最多 N 个额外检索查询，全部经一次 RRF 融合汇总。"
          }
        },
        {
          "key": "rerank_model",
          "env": "PNEUMA_KNOWLEDGE_RECALL_RERANK_MODEL",
          "type": "string",
          "default": "",
          "apply": "hot",
          "label": {
            "en": "Claim reranker",
            "zh": "断言重排模型"
          },
          "description": {
            "en": "Empty = off (measured: no gain on claim-level retrieval). \"llm\" = LLM reranker on the recall model; \"llm:<spec>\" picks the model; a bare model name uses the OpenRouter /rerank endpoint.",
            "zh": "空 = 关（实测：断言级检索上没有增益）。\"llm\" = 用召回模型做 LLM 重排；\"llm:<spec>\" 指定模型；裸模型名走 OpenRouter /rerank 端点。"
          }
        },
        {
          "key": "rerank_candidates",
          "env": "PNEUMA_KNOWLEDGE_RECALL_RERANK_CANDIDATES",
          "type": "int",
          "default": 120,
          "apply": "hot",
          "label": {
            "en": "Rerank candidate depth",
            "zh": "重排候选深度"
          },
          "description": {
            "en": "Retrieval depth per query per face when reranking; the reranker then scores the full deduped union.",
            "zh": "开启重排时每个查询、每个面的检索深度；重排器随后对整个去重并集打分。"
          }
        }
      ]
    },
    {
      "id": "models",
      "title": {
        "en": "Models",
        "zh": "模型"
      },
      "summary": {
        "en": "The engine's model roles. The compile model is the one real quality lever — a stronger model directly produces a better library.",
        "zh": "引擎的模型角色。编译模型是唯一真正的质量杠杆——更强的模型直接产出更好的库。"
      },
      "doc": "docs/reference/configuration.md#models",
      "file": "engine.yaml",
      "knobs": [
        {
          "key": "compile",
          "env": "PNEUMA_KNOWLEDGE_LLM_MODEL_COMPILE",
          "type": "string",
          "default": "",
          "apply": "restart",
          "label": {
            "en": "Compile model",
            "zh": "编译模型"
          },
          "description": {
            "en": "Must support tool calling: the compile agent writes through tools. The quality lever of the whole engine.",
            "zh": "必须支持工具调用：编译代理是通过工具写入的。整个引擎的质量杠杆。"
          }
        },
        {
          "key": "image_mode",
          "env": "PNEUMA_KNOWLEDGE_COMPILE_IMAGE_MODE",
          "type": "enum",
          "enum": [
            "auto",
            "caption",
            "native"
          ],
          "default": "auto",
          "apply": "restart",
          "label": {
            "en": "Compile image delivery",
            "zh": "编译图片传递方式"
          },
          "description": {
            "en": "caption sends labelled caption/OCR text only; native sends those labels plus actual image content blocks; auto uses the active model profile and falls back to caption when capability is unknown.",
            "zh": "caption 只发送带来源标签的图片描述/OCR；native 在这些标签之外还发送真正的图片内容块；auto 读取当前模型的能力档案，能力未知时回落到 caption。"
          }
        },
        {
          "key": "recall",
          "env": "PNEUMA_KNOWLEDGE_LLM_MODEL_RECALL",
          "type": "string",
          "default": "",
          "apply": "restart",
          "label": {
            "en": "Recall model",
            "zh": "召回模型"
          },
          "description": {
            "en": "Retrieval planning/glance and the briefing ask. Fast and cheap is fine.",
            "zh": "检索规划/概览与简报问答。又快又便宜就够了。"
          }
        },
        {
          "key": "answer",
          "env": "PNEUMA_KNOWLEDGE_LLM_MODEL_ANSWER",
          "type": "string",
          "default": "",
          "apply": "restart",
          "label": {
            "en": "Answer model",
            "zh": "答题模型"
          },
          "description": {
            "en": "Final fast-answer generation only. Empty borrows the recall role.",
            "zh": "只负责快速召回的最终答案。留空则借用召回角色。"
          }
        },
        {
          "key": "answer_reasoning_effort",
          "env": "PNEUMA_KNOWLEDGE_ANSWER_REASONING_EFFORT",
          "type": "enum",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "apply": "restart",
          "label": {
            "en": "Answer reasoning effort",
            "zh": "答题推理强度"
          },
          "description": {
            "en": "Reasoning effort sent only on the final fast-answer call; empty keeps the provider default.",
            "zh": "只在快速召回的最终答题调用中发送；留空则沿用模型供应商默认值。"
          }
        },
        {
          "key": "deep",
          "env": "PNEUMA_KNOWLEDGE_LLM_MODEL_DEEP",
          "type": "string",
          "default": "",
          "apply": "restart",
          "label": {
            "en": "Deep-recall model",
            "zh": "深度召回模型"
          },
          "description": {
            "en": "The agentic search lane. Empty borrows the recall role.",
            "zh": "代理式搜索车道。留空则借用召回角色。"
          }
        },
        {
          "key": "embedding",
          "env": "PNEUMA_KNOWLEDGE_EMBEDDING_MODEL",
          "type": "string",
          "default": "fake:384",
          "apply": "restart",
          "label": {
            "en": "Embedding model",
            "zh": "向量模型"
          },
          "description": {
            "en": "fake:<dim> is deterministic and keyless. A vector collection's dimension is fixed at creation, so switching real models means a new collection.",
            "zh": "fake:<dim> 确定且无需密钥。向量集合的维度在创建时就固定了，所以换真实模型意味着换一个新集合。"
          }
        }
      ]
    },
    {
      "id": "persona",
      "title": {
        "en": "Owner profile",
        "zh": "主人档案"
      },
      "summary": {
        "en": "Whose viewpoint the material is written from. Compiles read it to know how to address the owner and which calendar day a timestamp falls on — facts stay in the material.",
        "zh": "材料是从谁的视角写的。编译读它来知道该怎么称呼主人、时间戳算在哪一个日历日上——事实本身仍然只住在材料里。"
      },
      "doc": "docs/architecture.md#6-the-compile-contract-skill",
      "file": "persona/profile.yaml",
      "knobs": [
        {
          "key": "profile",
          "env": "",
          "type": "document",
          "default": "",
          "apply": "future_compiles",
          "label": {
            "en": "Profile document",
            "zh": "档案文档"
          },
          "description": {
            "en": "The owner's own file: name, occupation, locale, and the provenance of each detected value. A detected value is never presented as the owner's own setting until its provenance says so.",
            "zh": "主人自己的文件：称呼、职业、地区设置，以及每个探测值的来源标记。探测出来的值在来源标记改写之前，永远不会被当成主人自己的设定。"
          }
        }
      ]
