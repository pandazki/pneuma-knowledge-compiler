{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge.pneuma.dev/schemas/source/im-v1.schema.json",
  "title": "Pneuma Instant Message Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "archive_id", "owner_user_ids", "users", "conversations"],
  "properties": {
    "schema": {"const": "pneuma.source.im/v1"},
    "provider": {"enum": ["slack", "mock"]},
    "archive_id": {"type": "string", "minLength": 1},
    "owner_user_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "users": {"type": "array", "items": {"$ref": "#/$defs/user"}},
    "conversations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/conversation"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "display_name"],
      "properties": {
        "user_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "email": {"type": ["string", "null"]},
        "is_bot": {"type": "boolean", "default": false}
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "sender_id", "sent_at", "text"],
      "properties": {
        "message_id": {"type": "string", "minLength": 1},
        "sender_id": {"type": "string", "minLength": 1},
        "sent_at": {"type": "string", "format": "date-time"},
        "text": {"type": "string"},
        "thread_id": {"type": ["string", "null"]},
        "edited_at": {"type": ["string", "null"], "format": "date-time"},
        "reactions": {"type": "array", "items": {"$ref": "#/$defs/reaction"}},
        "images": {"type": "array", "items": {"$ref": "#/$defs/image"}},
        "metadata": {"type": "object"}
      }
    },
    "derivedImageText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "producer"],
      "properties": {
        "kind": {"enum": ["caption", "ocr"]},
        "text": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1}
      }
    },
    "base64ImageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "data", "sha256"],
      "properties": {
        "type": {"const": "base64"},
        "data": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "urlImageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "sha256"],
      "properties": {
        "type": {"const": "url"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "mime_type", "source"],
      "properties": {
        "image_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp", "image/gif"]},
        "source": {
          "oneOf": [
            {"$ref": "#/$defs/base64ImageSource"},
            {"$ref": "#/$defs/urlImageSource"}
          ]
        },
        "derived": {"type": "array", "items": {"$ref": "#/$defs/derivedImageText"}},
        "metadata": {"type": "object"}
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "conversation_type", "title", "member_ids", "messages"],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1},
        "conversation_type": {"enum": ["channel", "dm", "group_dm"]},
        "title": {"type": "string", "minLength": 1},
        "member_ids": {"type": "array", "items": {"type": "string"}},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
        "metadata": {"type": "object"}
      }
    }
  }
}
