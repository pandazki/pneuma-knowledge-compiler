      "html": "<button class=\"ds-btn-secondary\">运行检索实验 →</button>",
      "css": ".ds-btn-secondary{display:inline-flex;height:40px;align-items:center;justify-content:center;gap:6px;border:0;border-radius:999px;padding:0 16px;background:var(--color-surface-muted,#e7ebe8);color:var(--color-text,#0b203a);font:540 15px/1.2 var(--font-sans,system-ui,sans-serif);cursor:pointer;transition:background-color 120ms cubic-bezier(.16,1,.3,1)}.ds-btn-secondary:hover{background:var(--color-surface-hover,#dce6e4)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-ring,#155fc6);outline-offset:2px}"
    },
