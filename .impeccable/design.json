      "name": "Primary Route Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary departure action for a station or journey.",
      "html": "<button class=\"ds-btn-primary\">回放一份材料</button>",
      "css": ".ds-btn-primary{display:inline-flex;height:40px;align-items:center;justify-content:center;gap:6px;border:0;border-radius:999px;padding:0 16px;background:var(--color-accent,#df4a2b);color:var(--color-accent-foreground,#fffaf2);font:540 15px/1.2 var(--font-sans,system-ui,sans-serif);cursor:pointer;transition:opacity 120ms cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{opacity:.9}.ds-btn-primary:active{opacity:.78}.ds-btn-primary:focus-visible{outline:2px solid var(--color-ring,#155fc6);outline-offset:2px}"
    },
    {
