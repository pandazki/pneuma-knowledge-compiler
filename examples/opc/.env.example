# ──────────────────────────────────────────────────────────────────────────────
# Configuration for the OPC example. Copy to .env before use.
# This directory is a complete scaffold-born project: the prebuilt library browses
# out of the box with no key (./demo.sh); a key enables Q&A and recompiling with
# your own parameters. The key lives in .env only (gitignored here) — never in
# anything that gets committed.
# ──────────────────────────────────────────────────────────────────────────────

# [required for Q&A / recompile] OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# [required for recompile] Compile model (must support tool calling). The prebuilt
# library was compiled with exactly this one:
PNEUMA_APP_COMPILE_MODEL=openrouter:openai/gpt-5.6-luna

# [required for Q&A] Recall model: the single-shot ask call.
PNEUMA_APP_RECALL_MODEL=openrouter:openai/gpt-5.6-luna

# [required for Q&A / recompile] Embedding model (L2 semantic vectors; keyless
# browsing falls back to deterministic vectors automatically).
PNEUMA_APP_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small

# [optional] Deep-recall model (multi-round retrieval agent); empty falls back to RECALL.
# PNEUMA_APP_DEEP_MODEL=

# This example's own compose project name and port block (disjoint from the
# generated-project defaults and the dev stack).
PNEUMA_APP_COMPOSE_PROJECT=pneuma-opc-example
PNEUMA_APP_PG_PORT=25432
PNEUMA_APP_QDRANT_PORT=26333
PNEUMA_APP_QDRANT_GRPC_PORT=26334
PNEUMA_APP_MEILI_PORT=27700
# Project-private Docker subnet (avoids default address-pool exhaustion).
PNEUMA_APP_SUBNET=10.222.223.0/24
# PNEUMA_APP_API_PORT=28000
# PNEUMA_APP_WEB_PORT=24173

# [optional] Tenant id: one id, one library. The prebuilt library belongs to u-opc-lin.
PNEUMA_APP_USER_ID=u-opc-lin

# [required once copied outside the repository] Absolute path to the framework repo
# (auto-probed upward while inside it).
# PNEUMA_APP_FRAMEWORK_REPO=
