        ],"authorship":{"authored_id":"g06-d17-pilot-chat-auth","occurred_at":"2026-03-18T10:18:00+08:00","author_role":"operations","content_class":"signal","links":{"story_beat_ids":["D17"],"fact_ids":["F03","F07"],"continuity_ids":["C03"]}}},
