# ─────────────────────────────────────────────────────────────────────────────
# pneuma-knowledge-compiler 配置模板。
# 无密钥体验请直接运行 `uv run python examples/seed_demo.py` 并导入内置 preset；
# 需要真实编译/召回时再复制为 .env，并配置一个 OpenRouter key。
# LLM 与 embedding 全部复用 OpenRouter，无需其他供应商的 key。
# 中间件地址（Postgres/Qdrant/Meilisearch）的默认值已对齐 infra/docker-compose.yml，
# 本地跑 demo 无需在这里配置。
# ─────────────────────────────────────────────────────────────────────────────

# 【可选】引擎目录：把本部署的策略文件、编译契约、提示词覆盖与主人档案集中成一个被版本化的
# 单元（docs/design/engine-console.zh-CN.md）。留空 = 不启用，行为与这个概念出现之前完全一致，
# 且 /v1/engine/* 返回 404。设上之后优先级是：进程 env > 引擎文件 > 框架默认。注意本文件里的值
# 不是「进程 env」而是 dotenv，排在引擎文件之下——所以启用引擎目录之后，策略就只写在那里，
# 这个文件只留密钥与基础设施；要为单次运行盖过引擎，请在命令行上导出真正的环境变量。
# PNEUMA_KNOWLEDGE_ENGINE_DIR=./engine

# 【真实模型可选】OpenRouter API key（https://openrouter.ai/keys）。
OPENROUTER_API_KEY=sk-or-替换成你的key

# LLM 按操作路由（都走 OpenRouter）。这里使用公开的通用示例；可替换为任意
# 支持 tool calling / structured output 的 openrouter:<model>。
PNEUMA_KNOWLEDGE_LLM_MODEL_COMPILE=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_RECALL=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_DEEP=openrouter:openai/gpt-4o-mini
PNEUMA_KNOWLEDGE_LLM_MODEL_SKILL=openrouter:openai/gpt-4o-mini

# 【可选】所有角色共用的供应商调用护栏（默认值已够用，通常不需要改）：
#   LLM_TIMEOUT     = 单次请求超时（秒）。故意设得很大：目的是防「挂死」而不是防「慢」，
#                     调小会误杀慢而仍活着的请求。
#   LLM_MAX_RETRIES = langchain 自带的瞬时错误（429/5xx/连接重置）重试次数。
# PNEUMA_KNOWLEDGE_LLM_TIMEOUT=600
# PNEUMA_KNOWLEDGE_LLM_MAX_RETRIES=3

# 【图片编译】首版原生媒体边界仅支持 IM 消息上的 JPEG/PNG/WebP/GIF。
# 图片原件进入私有 S3 兼容 L0（本地 infra 使用 RustFS），caption/OCR 始终保留派生标签。
#   auto    = 按编译模型 profile 选择；能力未知时保守回落 caption
#   caption = 只交付带标签的 caption/OCR，不声称模型看过原图
#   native  = 同时交付真实图片 content block；provider 不支持时显式失败
# 引擎目录启用后优先写 models.image_mode；下面只适合无引擎目录或进程级覆盖。
# PNEUMA_KNOWLEDGE_COMPILE_IMAGE_MODE=auto
# PNEUMA_KNOWLEDGE_MEDIA_S3_ENDPOINT_URL=http://localhost:19000
# PNEUMA_KNOWLEDGE_MEDIA_S3_ACCESS_KEY=pneuma_media_dev
# PNEUMA_KNOWLEDGE_MEDIA_S3_SECRET_KEY=pneuma_media_dev_secret_change_me
# PNEUMA_KNOWLEDGE_MEDIA_S3_BUCKET=pneuma-media
# PNEUMA_KNOWLEDGE_MEDIA_MAX_IMAGE_BYTES=20971520

# 【可选】部署默认时区：主体档案里没设时区时，按这个时区数「日历日」（分节、今天是哪天）。
# 解析链是 provider → 主体档案 → 这里。编译契约会照实声明它是部署默认值，而不是主体自己的设定。
# 只服务某一地区的部署应该显式设一次：对 +08:00 的主体用 UTC，会把三分之一的夜间对话归到前一天。
# PNEUMA_KNOWLEDGE_DEFAULT_TIMEZONE=Asia/Shanghai

# L2 语义向量的 embedding（走 OpenRouter，1536 维，复用上面的 key）。
PNEUMA_KNOWLEDGE_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small

# L2 分块策略（默认即 semantic，此行仅作展示）：
#   semantic = 用 LLM 判「一人一段 / 一主题一段」的边界（默认；入库时多一次 LLM 调用；
#              keyless/scripted 模型下自动回落 sentence）。
#   sentence = 纯机械的句子切分（无需 LLM，最省）。
# PNEUMA_KNOWLEDGE_CHUNK_STRATEGY=semantic

# 语义段之间是否允许重叠（只对 semantic 有意义；默认即 smart，此行仅作展示）：
#   smart = 模型返回前闭后闭区间，转折句同时属于前后两段（重叠多少逐个边界判断，
#           最多 3 块——这个上限挡住「每段都是全文」的退化）。
#   off   = 原来的零重叠切法，也是此前全部测量所用的基线。
# PNEUMA_KNOWLEDGE_SEMANTIC_OVERLAP=smart

# 【可选】编译后覆盖挑战：对刚编译的材料盲出题、查 claim 面、反思判缺口，
# 确认的缺口触发一次补偿编译（写入照常过引用闸门）。默认关（每次编译多花模型调用）。
# PNEUMA_KNOWLEDGE_CHALLENGE_ENABLED=true
# PNEUMA_KNOWLEDGE_CHALLENGE_MAX_ROUNDS=2
# PNEUMA_KNOWLEDGE_CHALLENGE_MAX_QUESTIONS=6
# PNEUMA_KNOWLEDGE_CHALLENGE_COMPENSATE=true

# 【可选】文档滚动归档（rollover / groom）。一个长期主体的 canonical 文档会一直长大，
# 大到某个点就不再可用（实测出现过 435KB / 894 claims 的单文档，占全库 42%：整篇读不进
# 召回窗口，鸟瞰也退化成一堵墙）。rollover 就是给这件事做的机械保养，像日志轮转：
# 按尺寸触发、主体不变、旧卷冻结并以链接可达。它与 evolve 正交——evolve 重组「语义」
# （把一个主体拆成子主体），rollover 只轮转「尺寸」。
#   ROLLOVER_THRESHOLD_CHARS   = 本次编译写过的文档超过这个字符数（整份文件，含 frontmatter）
#                                就在同一条 per-user 队列上入队一个 groom job。0 = 关闭。
#                                只检查本次真写过的文档，存量大文件会在下次被写到时自然触发。
#   ROLLOVER_KEEP_RECENT_CHARS = 活跃文档大致保留多少最近尾部。故意是「大致」：切分线落在
#                                claim 块边界，永不切断一个 claim，所以实际保留的是能装下的
#                                最大整块后缀。必须显著小于阈值，否则一次归档几乎不搬东西，
#                                下次写入又会再触发。
# PNEUMA_KNOWLEDGE_ROLLOVER_THRESHOLD_CHARS=40000
# PNEUMA_KNOWLEDGE_ROLLOVER_KEEP_RECENT_CHARS=12000

# 【可选】Langfuse 可观测性：三项都填才开启追踪；任一为空则自动降级为 no-op（零影响）。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000

# 【必填，无默认值】本部署编译时使用的契约版本号。框架不内置任何领域契约，也不会替你挑一份：
# 应用在启动时用 register_skill_base(version, skill) 注册自己的契约，这里填同一个版本字符串。
# 留空 → 第一次编译就会失败，并在报错里指出格式文档与可参考的现成契约。
#   怎么写（格式与判断力）：docs/guides/compile-contract.zh-CN.md
#   可参考的现成契约：packages/pneuma-knowledge-strategies/（personal-knowledge）
# PNEUMA_KNOWLEDGE_USER_SCHEMA_BASE_VERSION=
