{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pneuma.dev/schemas/source/document-library-v1.schema.json",
  "title": "Pneuma Document Library Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "library_id", "title", "documents"],
  "properties": {
    "schema": {"const": "pneuma.source.document-library/v1"},
    "provider": {"enum": ["obsidian", "mock"]},
    "library_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]},
        "embedded": {"type": "boolean", "default": false}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "path", "title", "content", "frontmatter", "tags", "links"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "frontmatter": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "created_at": {"type": ["string", "null"], "format": "date-time"},
        "modified_at": {"type": ["string", "null"], "format": "date-time"},
        "metadata": {"type": "object"}
      }
    }
  }
}
