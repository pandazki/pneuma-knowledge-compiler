__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/
dist/
node_modules/
*.tsbuildinfo
.env
.DS_Store

# Editor / merge detritus — never part of a change, and easy to stage by accident.
*.swp
*~
*.orig
*.rej
.idea/

# Root canonical git repos (per-user, large and rebuildable).
/data/

# Per-example local state: credentials and raw run output, kept locally, never shipped.
examples/opc/.env
examples/opc/var/

# evals/ runtime. The benchmark corpora are third-party (LoCoMo is CC BY-NC; the
# EverMemBench code repo ships no LICENSE) and are fetched, never vendored; run outputs and
# the derived per-conversation configs are large and regenerable.
evals/.env
evals/datasets/
evals/runs/
evals/*/.generated/
evals/*/strategist/
evals/*/scenario.strategist.yaml

# Pneuma workspace (project config + session state) — local, not part of the codebase.
.pneuma/

# Local-only private datasets: real personal/corporate material used for local
# experiments (raw captures, prepared payloads, prep scripts, derived memory).
# NEVER shipped — the open repository carries only synthetic fixtures.
/local/

# 设计工具的本机工作状态（不随仓库发布）
.impeccable/
/archive/

# keyed .env variants (a real key almost reached a public commit once — never again)
.env.keyed
