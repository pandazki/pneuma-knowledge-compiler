# ─────────────────────────────────────────────────────────────────────────────
# pneuma-knowledge-compiler configuration template.
# For a keyless look around, run `uv run python examples/seed_demo.py` and import the
# built-in preset; copy this file to .env and add an OpenRouter key only when you want
# real compilation and recall. LLMs and embeddings both go through OpenRouter, so no
# other provider key is needed. The middleware addresses (Postgres/Qdrant/Meilisearch)
# already default to infra/docker-compose.yml — a local demo needs nothing here.
#
# Every knob below is documented in full, in both languages:
#   docs/reference/configuration.md · docs/reference/configuration.zh-CN.md（中文）
# ─────────────────────────────────────────────────────────────────────────────

# [optional] Engine directory: this deployment's strategy files, compile contract, prompt
# overrides and owner profile as one versioned unit (docs/design/engine-console.md). Empty
# = disabled, behaviour identical to before the concept existed, and /v1/engine/* returns
# 404. Once set, precedence is: process env > engine files > framework defaults. Values in
# THIS file are dotenv, not process env, so they rank below the engine files — with an
# engine directory in use, strategy lives only there and this file keeps just keys and
# infrastructure. To override the engine for a single run, export a real environment
# variable on the command line.
# PNEUMA_KNOWLEDGE_ENGINE_DIR=./engine

# [optional, needed for real models] OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-replace-with-your-key

# Per-operation LLM routing (all through OpenRouter). These are the same models the
# scaffold generates projects with; any openrouter:<model> that supports tool calling and
# structured output works.
PNEUMA_KNOWLEDGE_LLM_MODEL_COMPILE=openrouter:openai/gpt-5.6-luna
PNEUMA_KNOWLEDGE_LLM_MODEL_RECALL=openrouter:openai/gpt-5.6-luna
PNEUMA_KNOWLEDGE_LLM_MODEL_DEEP=openrouter:openai/gpt-5.6-terra
PNEUMA_KNOWLEDGE_LLM_MODEL_SKILL=openrouter:openai/gpt-5.6-luna

# [optional] Pin which upstream provider serves an `openrouter:<model>` request. Empty =
# OpenRouter's own routing. With an explicit order and fallbacks off, the request fails
# rather than silently landing on a third-party reseller of the same model.
# PNEUMA_KNOWLEDGE_OPENROUTER_PROVIDER_ORDER=openai
# PNEUMA_KNOWLEDGE_OPENROUTER_ALLOW_FALLBACKS=false

# [optional] Provider call guardrails shared by every role (the defaults are fine):
#   LLM_TIMEOUT     = per-request timeout in seconds. Deliberately large: it guards
#                     against hangs, not against slowness, and lowering it kills requests
#                     that are slow but alive.
#   LLM_MAX_RETRIES = langchain's own retry count for transient errors (429/5xx/resets).
# PNEUMA_KNOWLEDGE_LLM_TIMEOUT=600
# PNEUMA_KNOWLEDGE_LLM_MAX_RETRIES=3

# [image compile] The first native-media boundary covers JPEG/PNG/WebP/GIF on IM messages
# only. Originals land in private S3-compatible L0 storage (RustFS in the local stack),
# and caption/OCR always keeps its derived label.
#   auto    = follow the compile model's profile; fall back to caption when unknown
#   caption = deliver labelled caption/OCR only, never claiming the model saw the original
#   native  = also deliver real image content blocks; fail loudly if the provider cannot
# With an engine directory in use, prefer models.image_mode there; the line below suits a
# deployment without one, or a process-level override.
# PNEUMA_KNOWLEDGE_COMPILE_IMAGE_MODE=auto
# PNEUMA_KNOWLEDGE_MEDIA_S3_ENDPOINT_URL=http://localhost:19000
# PNEUMA_KNOWLEDGE_MEDIA_S3_ACCESS_KEY=pneuma_media_dev
# PNEUMA_KNOWLEDGE_MEDIA_S3_SECRET_KEY=pneuma_media_dev_secret_change_me
# PNEUMA_KNOWLEDGE_MEDIA_S3_BUCKET=pneuma-media
# PNEUMA_KNOWLEDGE_MEDIA_MAX_IMAGE_BYTES=20971520

# [optional] The deployment's default timezone: the zone calendar days are counted in
# (sectioning, "what day is today") when the subject profile states none. The resolution
# chain is provider → subject profile → this. The compile contract states plainly that it
# is a deployment default rather than the subject's own setting. A deployment serving one
# region should set it once: leaving UTC for a +08:00 subject files a third of the evening
# conversations under the previous day.
# PNEUMA_KNOWLEDGE_DEFAULT_TIMEZONE=Asia/Shanghai

# Embeddings for the L2 semantic vectors (through OpenRouter, 1536 dims, same key).
PNEUMA_KNOWLEDGE_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small

# L2 chunking strategy (semantic is the default; this line only shows it):
#   semantic = an LLM detects topic/episode boundaries and returns a grounded title and
#              description per episode (one extra LLM call per source at ingest; scripted
#              or keyless models fall back to sentence automatically).
#   sentence = purely mechanical sentence splitting (no LLM, cheapest).
# PNEUMA_KNOWLEDGE_CHUNK_STRATEGY=semantic

# Whether semantic segments may overlap (semantic only; smart is the default):
#   smart = the model returns closed intervals, so a hinge sentence belongs to both
#           neighbouring segments. How much to share is judged per boundary, capped at
#           three shared blocks — the cap is what stops "every segment is the whole
#           document" degeneration.
#   off   = the original zero-overlap cut.
# PNEUMA_KNOWLEDGE_SEMANTIC_OVERLAP=smart

# [optional] Post-compile coverage challenge: blind questions over the material just
# compiled, a probe of the claim face, and a reflection that judges gaps; confirmed gaps
# trigger one compensation compile (whose writes pass the ordinary citation gate). Off by
# default — it spends extra model calls on every compile.
# PNEUMA_KNOWLEDGE_CHALLENGE_ENABLED=true
# PNEUMA_KNOWLEDGE_CHALLENGE_MAX_ROUNDS=2
# PNEUMA_KNOWLEDGE_CHALLENGE_MAX_QUESTIONS=6
# PNEUMA_KNOWLEDGE_CHALLENGE_COMPENSATE=true

# [optional] Post-compile brief: one model call narrates the compile's mechanical claim
# events into a short brief shown on the History timeline, labelled derived. Off by
# default — it spends one extra model call per compile.
# PNEUMA_KNOWLEDGE_BRIEF_ENABLED=true
# PNEUMA_KNOWLEDGE_LLM_MODEL_BRIEF=

# [optional] Document rollover (groom). A long-lived subject's canonical document keeps
# growing until it stops being usable (observed live: one 435KB / 894-claim document, 42%
# of the whole library — too large to read into a recall window, and it degraded the
# overview into a wall). Rollover is the mechanical maintenance for that, like log
# rotation: size-triggered, subject unchanged, older volumes frozen and reachable by link.
# It is orthogonal to evolve — evolve reorganizes MEANING (splitting one subject into
# sub-subjects), rollover only rotates SIZE.
#   ROLLOVER_THRESHOLD_CHARS   = a document this compile wrote that exceeds this many
#                                characters (whole file, frontmatter included) enqueues a
#                                groom job on the same per-user queue. 0 = disabled. Only
#                                documents actually written this round are checked; an
#                                existing large file triggers next time it is written to.
#   ROLLOVER_KEEP_RECENT_CHARS = roughly how much recent tail the active document keeps.
#                                Deliberately "roughly": the cut lands on a claim block
#                                boundary and never splits a claim, so what remains is the
#                                largest whole-block suffix that fits. It must be well
#                                below the threshold, or a rollover moves almost nothing
#                                and the next write triggers it again.
# PNEUMA_KNOWLEDGE_ROLLOVER_THRESHOLD_CHARS=40000
# PNEUMA_KNOWLEDGE_ROLLOVER_KEEP_RECENT_CHARS=12000

# [optional] Langfuse observability: tracing turns on only when all three are set; any one
# empty degrades to a no-op with zero impact.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000

# [required, no default] The contract version this deployment compiles with. The framework
# ships no domain contract and will not pick one for you: the application registers its own
# at startup with register_skill_base(version, skill), and this is the same version string.
# Empty → the first compile fails, naming the format guide and the reference contracts.
#   How to write one (format and judgement): docs/guides/compile-contract.md
#   Reference contracts to start from: packages/pneuma-knowledge-strategies/
# PNEUMA_KNOWLEDGE_USER_SCHEMA_BASE_VERSION=
