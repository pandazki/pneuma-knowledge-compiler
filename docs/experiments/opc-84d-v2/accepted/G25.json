                  {"header_id": "g25e-chain-reply-h03", "name": "To", "value": "林舟 <lin.zhou@seamlog.test>", "authorship": {"authored_id": "g25e-chain-reply-h03-auth", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}},
                  {"header_id": "g25e-chain-reply-h04", "name": "Subject", "value": "Re: 材料替代记录：导入结果与待确认项", "authorship": {"authored_id": "g25e-chain-reply-h04-auth", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}},
                  {"header_id": "g25e-chain-reply-h05", "name": "Message-ID", "value": "<g25e-chain-reply@bamboo.test>", "authorship": {"authored_id": "g25e-chain-reply-h05", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}},
                  {"header_id": "g25e-chain-reply-h06", "name": "In-Reply-To", "value": "<g25e-chain-root@seamlog.test>", "authorship": {"authored_id": "g25e-chain-reply-h06-auth", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}},
                  {"header_id": "g25e-chain-reply-h07", "name": "References", "value": "<g25e-chain-root@seamlog.test>", "authorship": {"authored_id": "g25e-chain-reply-h07-auth", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}}
                ],
                "full_text": "林舟：\n\n材料是我下午那段，来源位置也是我从页面里选的那一个，导入本身没有问题。状态先别动。我还要和现场的人确认这次替代是不是已经按原计划执行；我现在只能说材料进入了记录，不能说它完成了确认，更不能替吴岚确认采购接受这种写法。\n\n旧说明页再跳一次很烦，但它和“待确认”不是同一个问题。先把跳转修正做成可看见的进度，别为了让链接顺手就换掉我原来选的来源。等我得到明确答复，再由我或该答复的留下人更新状态；这封回复不算签字。你可以把本邮件的回复位置存到该状态旁，方便之后辨认它是一个待核对的意见，而不是原材料中的旧说法。若现场给出的是不同版本，我会把它作为新的来源接入，而不是回改今天导入的材料片段；在那之前，页面只需要诚实地显示尚未确认。\n\n陈放",
                "in_reply_to": "g25e-chain-root", "references": ["g25e-chain-root"], "attachments": [],
                "authorship": {"authored_id": "g25e-chain-reply-auth", "occurred_at": "2026-05-15T14:41:00+08:00", "author_role": "operations", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}
              }
            ],
            "authorship": {"authored_id": "g25e-chain-thread-auth", "occurred_at": "2026-05-15T14:08:00+08:00", "author_role": "product", "content_class": "signal", "links": {"story_beat_ids": ["D75"], "fact_ids": ["F13"], "continuity_ids": ["C02", "C06"]}}
          },
          {
