  "sources": {
    "meetings": [
      {
        "source_id": "G27d80ExtensionMeetingSource",
        "authorship": {"authored_id": "G27d80ExtensionMeetingSourceAuth", "occurred_at": "2026-05-20T10:06:00+08:00", "author_role": "product", "content_class": "signal", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13", "F14"], "continuity_ids": ["C03", "C05", "C06"]}},
        "schema": "pneuma.source.meeting/v1",
        "provider": "mock",
        "meeting_id": "G27d80ExtensionMeeting",
        "title": "阶段复盘后的条件核对",
        "started_at": "2026-05-20T10:06:00+08:00",
        "ended_at": "2026-05-20T10:58:00+08:00",
        "timezone": "Asia/Shanghai",
        "owner_participant_ids": ["G27meetLin"],
        "participants": [
          {"participant_id": "G27meetLin", "display_name": "林舟", "role": "product", "synthetic_address": "lin.zhou@seamlog.example.test"},
          {"participant_id": "G27meetWu", "display_name": "吴岚", "role": "manager", "synthetic_address": "wu.lan@bamboo.example.test"},
          {"participant_id": "G27meetZhao", "display_name": "赵楠", "role": "partner", "synthetic_address": "nan.zhao@sharedflat.example.test"}
        ],
        "agenda": [
          {"agenda_id": "G27d80Agenda01", "text": "区分两条变更链带来的有限价值，与竹影既有的项目管理和采购职责。", "authorship": {"authored_id": "G27d80Agenda01Auth", "occurred_at": "2026-05-20T10:06:00+08:00", "author_role": "product", "content_class": "signal", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13", "F14"], "continuity_ids": ["C03", "C05", "C06"]}}},
          {"agenda_id": "G27d80Agenda02", "text": "只记录口头延长意向的条件，不把任何条件写成完成。", "authorship": {"authored_id": "G27d80Agenda02Auth", "occurred_at": "2026-05-20T10:07:00+08:00", "author_role": "manager", "content_class": "signal", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C03", "C05"]}}}
        ],
        "utterances": [
          {"utterance_id": "G27d80Turn01", "speaker_id": "G27meetLin", "started_at": "2026-05-20T10:06:00+08:00", "ended_at": "2026-05-20T10:09:00+08:00", "text": "药膏刚送到，我下楼拿的时候把门禁卡落在电梯口，绕回来才进门。腿没什么大事。赵楠还在问晚饭要不要买那家总是卖完的豆腐，我也还没回他。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn01Auth", "occurred_at": "2026-05-20T10:06:00+08:00", "author_role": "product", "content_class": "noise", "links": {"story_beat_ids": ["D80"], "fact_ids": [], "continuity_ids": []}}},
          {"utterance_id": "G27d80Turn02", "speaker_id": "G27meetWu", "started_at": "2026-05-20T10:09:00+08:00", "ended_at": "2026-05-20T10:13:00+08:00", "text": "昨天我说它对两条变更记录有用，意思是有人能把材料、确认和当前状态重新找回来。它没有替我们排工期，也没有替采购判断该不该花钱。若把这点写成“项目都能管了”，我反而不会继续看。陈放仍得在现场说哪一项成立，我们内部也仍得自己把采购问题带回原流程。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn02Auth", "occurred_at": "2026-05-20T10:09:00+08:00", "author_role": "manager", "content_class": "signal", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13"], "continuity_ids": ["C03", "C05", "C06"]}}},
          {"utterance_id": "G27d80Turn03", "speaker_id": "G27meetLin", "started_at": "2026-05-20T10:13:00+08:00", "ended_at": "2026-05-20T10:17:00+08:00", "text": "我原本想把复盘标题写成“继续使用的方案”，现在听起来太大。两条链可读，只证明这个窄位置没白做；它不能替代你们现有的项目表，也不能把采购的等待变成产品里的一个绿色状态。标题若暗示它负责派活或批准费用，读者会忘记那些决定仍在你们手里。我宁可让读者看到一条链还没回答什么，也不把空白藏在一个看起来很完整的项目视图里。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn03Auth", "occurred_at": "2026-05-20T10:13:00+08:00", "author_role": "product", "content_class": "signal", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13"], "continuity_ids": ["C03", "C05", "C06"]}}},
          {"utterance_id": "G27d80Turn04", "speaker_id": "G27meetZhao", "started_at": "2026-05-20T10:17:00+08:00", "ended_at": "2026-05-20T10:20:00+08:00", "text": "我只听懂一半：它帮你们翻到以前那句话，不帮你们决定下周谁去跑材料。那这次要谈的是不是把它多留一阵？我午饭还约了人，先确认自己没有把“有用”听成“买下”。如果将来有人问为什么一条材料没被采用，这个工具只能带人回到当时的话，不能替项目负责人给出新的理由，对吗？", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn04Auth", "occurred_at": "2026-05-20T10:17:00+08:00", "author_role": "partner", "content_class": "ambiguous", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13", "F14"], "continuity_ids": ["C05", "C06"]}}},
          {"utterance_id": "G27d80Turn05", "speaker_id": "G27meetWu", "started_at": "2026-05-20T10:20:00+08:00", "ended_at": "2026-05-20T10:25:00+08:00", "text": "先别叫买下。可以讨论再延六周，但那只是口头意向，且要先把三件事各自落到位：数据处理附录要签，删除演练要有业务方确认，试点尾款要处理。少一项都不是自动顺延，也不是长期合作的承诺。三件事的负责人和顺序也不能由这句口头话省掉。", "interruption_of_utterance_id": "G27d80Turn04", "authorship": {"authored_id": "G27d80Turn05Auth", "occurred_at": "2026-05-20T10:20:00+08:00", "author_role": "manager", "content_class": "signal", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C03", "C05"]}}},
          {"utterance_id": "G27d80Turn06", "speaker_id": "G27meetLin", "started_at": "2026-05-20T10:25:00+08:00", "ended_at": "2026-05-20T10:29:00+08:00", "text": "那我现在只需要确认一件写法：条件清单的标题该写“待处理事项”，还是干脆只放在内部备注里？我怕标题太像续用通知，又怕不写清楚，后来的人只看到一句口头话，不知道它还卡在哪。我的习惯是把空格都做成 checkbox，但这次若画得太像待办，可能又让人误会我能替对方分配动作。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn06Auth", "occurred_at": "2026-05-20T10:25:00+08:00", "author_role": "product", "content_class": "ambiguous", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C05"]}}},
          {"utterance_id": "G27d80Turn07", "speaker_id": "G27meetWu", "started_at": "2026-05-20T10:29:00+08:00", "ended_at": "2026-05-20T10:33:00+08:00", "text": "放内部备注，标题写“尚待处理”，不要让它像给采购的摘要。谁回了哪一项，就把那一项的原回复挂进去；其余格子继续空着。至于尾款，我仍没有预计日，这不是你靠改标题或多发一封信能解决的。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn07Auth", "occurred_at": "2026-05-20T10:29:00+08:00", "author_role": "manager", "content_class": "ambiguous", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F11", "F14"], "continuity_ids": ["C05"]}}},
          {"utterance_id": "G27d80Turn08", "speaker_id": "G27meetZhao", "started_at": "2026-05-20T10:33:00+08:00", "ended_at": "2026-05-20T10:36:00+08:00", "text": "那晚上不庆祝了，我本来还想买甜点。药膏说明让我两天别久站，林舟也正好别把条件表写到半夜。甜点店今天剩什么我晚点再问，跟这三项没关系。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn08Auth", "occurred_at": "2026-05-20T10:33:00+08:00", "author_role": "partner", "content_class": "noise", "links": {"story_beat_ids": ["D80"], "fact_ids": [], "continuity_ids": []}}},
          {"utterance_id": "G27d80Turn09", "speaker_id": "G27meetLin", "started_at": "2026-05-20T10:36:00+08:00", "ended_at": "2026-05-20T10:41:00+08:00", "text": "我还有个不确定处：删除演练是把确认栏发给吴岚，还是先请孙秋看附录文字后再一起发？如果两件事混在同一封邮件里，收件人会不会以为法律意见等于业务确认？我想把它们拆开，但也不想造成两条互相等着的线。邮件里该怎样标回执、待看和真正签字，我还没有一套不误导人的顺序。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn09Auth", "occurred_at": "2026-05-20T10:36:00+08:00", "author_role": "product", "content_class": "ambiguous", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C03", "C05"]}}},
          {"utterance_id": "G27d80Turn10", "speaker_id": "G27meetWu", "started_at": "2026-05-20T10:41:00+08:00", "ended_at": "2026-05-20T10:46:00+08:00", "text": "拆开。孙秋把红线版只交给你处理文本；给我的邮件只问删除演练的业务确认。确认栏要让我看见范围、回告和需要我勾选的位置，别把一整份附录贴在后面。这样我看完以后，答的是自己的栏，不是替别人解释文字。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn10Auth", "occurred_at": "2026-05-20T10:41:00+08:00", "author_role": "manager", "content_class": "signal", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C03", "C05"]}}},
          {"utterance_id": "G27d80Turn11", "speaker_id": "G27meetLin", "started_at": "2026-05-20T10:46:00+08:00", "ended_at": "2026-05-20T10:51:00+08:00", "text": "我会做两封短邮件：一封只留红线的页码和待签问题，一封只留删除确认栏。内部备注不转发；它只是提醒我别把口头意向写成事实。复盘标题也改成“两条记录的阅读回看”，不再假装它管理了别的工作。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn11Auth", "occurred_at": "2026-05-20T10:46:00+08:00", "author_role": "product", "content_class": "signal", "links": {"story_beat_ids": ["D79", "D80"], "fact_ids": ["F13", "F14"], "continuity_ids": ["C05", "C06"]}}},
          {"utterance_id": "G27d80Turn12", "speaker_id": "G27meetWu", "started_at": "2026-05-20T10:51:00+08:00", "ended_at": "2026-05-20T10:58:00+08:00", "text": "可以。明天别抄送一圈人，也不要拿回执当催促。我会先看确认栏；如果我只能说明一个位置有疑问，那封回复就只覆盖那个位置。其余问题留在原来的收件人那里，别在回复里替我归并。", "interruption_of_utterance_id": null, "authorship": {"authored_id": "G27d80Turn12Auth", "occurred_at": "2026-05-20T10:51:00+08:00", "author_role": "manager", "content_class": "signal", "links": {"story_beat_ids": ["D80"], "fact_ids": ["F14"], "continuity_ids": ["C03", "C05"]}}}
        ]
      }
    ],
